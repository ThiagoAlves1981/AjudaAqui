      "name": "findByCpf",
      "signature": "public abstract java.util.Optional<com.AjudaAqui.trabalhoFinalDAW.model.Cliente> com.AjudaAqui.trabalhoFinalDAW.repository.ClienteRepository.findByCpf(java.lang.String)",
      "query": {
        "query": "SELECT c FROM Cliente c WHERE c.cpf = :cpf"
