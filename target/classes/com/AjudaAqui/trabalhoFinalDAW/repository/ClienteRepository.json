    {
      "name": "findByNomeContainingIgnoreCaseOrCpfContaining",
      "signature": "public abstract org.springframework.data.domain.Page<com.AjudaAqui.trabalhoFinalDAW.model.Cliente> com.AjudaAqui.trabalhoFinalDAW.repository.ClienteRepository.findByNomeContainingIgnoreCaseOrCpfContaining(java.lang.String,java.lang.String,org.springframework.data.domain.Pageable)",
